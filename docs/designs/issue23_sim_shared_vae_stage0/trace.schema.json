{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psm:issue23:stage0:trace-event:v1",
  "title": "PROPOSED Stage0 raw timing span; no measured events",
  "description": "JSONL spans. Metadata manifest binds exact source Pair, checkpoint/config/actual VAE hashes, GPU UUID/backend, task seed initial-state digests, warmup/exclusion/CI policy. Never include secrets. GPU elapsed is not an IPC clock.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "arm", "profile", "topology", "task_id", "episode_id", "session_id", "request_id", "source_step", "stratum", "phase", "span_id", "parent_span_id", "clock_domain", "process_id", "start_ns", "end_ns", "gpu_elapsed_ns", "device_uuid", "stream_id", "bvae", "bpolicy", "blocking", "status"],
  "properties": {
    "version": {"const": "PSM23-TRACE-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["A", "B", "C", "D"]},
    "profile": {"enum": ["single_latency", "multi_sr_throughput"]},
    "topology": {"enum": ["same_gpu", "split_gpu", "multi"]},
    "task_id": {"type": ["string", "null"]},
    "episode_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "source_step": {"type": ["integer", "null"], "minimum": 0},
    "stratum": {"enum": ["load", "warmup", "first_no_history", "steady_full16", "partial_terminal", "chunk_middle", "cleanup"]},
    "phase": {"enum": ["model_worker_load", "observation_preprocess", "sim_step", "egl_render", "history_capture_png", "enqueue_copy", "vae_ready_queue", "history_vae", "feature_ipc_verify", "executor_wait", "ttt_queue", "fast_weight_update", "prefix_prepare", "prefix_inject", "current_frame_vae", "policy_ready_queue", "policy_prepare", "policy_generation", "response_decode", "ack_commit", "end", "boundary_history_drain", "first_action", "replan", "step_cycle", "capacity_backpressure"]},
    "span_id": {"type": "string", "minLength": 1},
    "parent_span_id": {"type": ["string", "null"]},
    "causal_predecessors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "clock_domain": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 1},
    "start_ns": {"$ref": "#/$defs/ns"},
    "end_ns": {"$ref": "#/$defs/ns"},
    "gpu_elapsed_ns": {"oneOf": [{"$ref": "#/$defs/ns"}, {"type": "null"}]},
    "device_uuid": {"type": ["string", "null"]},
    "stream_id": {"type": ["string", "null"]},
    "bvae": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
    "bpolicy": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
    "blocking": {"enum": ["foreground", "background", "mixed", "not_applicable"]},
    "status": {"enum": ["ok", "error", "timeout", "cancelled"]},
    "source_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "queue_items": {"type": "integer", "minimum": 0},
    "retained_bytes": {"type": "integer", "minimum": 0},
    "rss_bytes": {"type": "integer", "minimum": 0},
    "vram_bytes": {"type": "integer", "minimum": 0},
    "gpu_util_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "ttt_loss": {"type": "number"},
    "first_error_id": {"type": ["string", "null"]}
  },
  "$defs": {"ns": {"type": "string", "pattern": "^[0-9]{1,20}$"}}
}
